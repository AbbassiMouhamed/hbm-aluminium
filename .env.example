# Copy to .env for local development (do NOT commit .env)
# Vercel production: set these in Vercel → Project Settings → Environment Variables

# --- Option A (recommended): Brevo HTTP API ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_TO_EMAIL=contact@example.com
BREVO_FROM_EMAIL=no-reply@example.com
BREVO_FROM_NAME=HBM ALU Website

# --- Option B: Brevo SMTP (alternative) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
SMTP_FROM=no-reply@example.com
